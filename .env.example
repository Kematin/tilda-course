# Используется скриптом проверки внешнего HTTPS через Nginx.
COURSE_DOMAIN=coolaf.online

# Локальный порт Caddy. Он публикуется только на 127.0.0.1.
COURSE_PORT=8080

# Логин единственного ученика.
COURSE_USER=student

# Сгенерируйте: ./scripts/generate-password-hash.sh
# Важно: оставьте одинарные кавычки — они сохраняют символы $ внутри хеша.
COURSE_PASSWORD_HASH='CHANGE_ME'
